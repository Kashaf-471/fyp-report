graph Attributes {
graph [layout=neato,overlap=true,splines=line,bgcolor="white",pad="0.20",dpi=200];
node [fontname="Arial",fontsize=12,pin=true,style=filled,color="#B3C8C0",fillcolor="#F2F8F5",shape=ellipse];
edge [color="#A1B8AF",penwidth=1.0];
EvaluationCase [shape=box,fillcolor="#DDF0E7",color="#368D7D",fontsize=14,label="EvaluationCase",pos="201.6,0.0!",width=1.55,height=.45];
EvaluationCase_0 [label=<<U>case_id</U>>,pos="0,25.2!",height=.36]; EvaluationCase -- EvaluationCase_0;
EvaluationCase_1 [label=<encounter_id <FONT POINT-SIZE="9">(FK)</FONT>>,pos="0,-25.2!",height=.36]; EvaluationCase -- EvaluationCase_1;
EvaluationCase_2 [label=<source_ref>,pos="403.2,25.2!",height=.36]; EvaluationCase -- EvaluationCase_2;
EvaluationCase_3 [label=<reference_text>,pos="403.2,-25.2!",height=.36]; EvaluationCase -- EvaluationCase_3;
EvaluationRun [shape=box,fillcolor="#DDF0E7",color="#368D7D",fontsize=14,label="EvaluationRun",pos="201.6,-244.79999999999998!",width=1.55,height=.45];
EvaluationRun_0 [label=<<U>run_id</U>>,pos="0,-169.20000000000002!",height=.36]; EvaluationRun -- EvaluationRun_0;
EvaluationRun_1 [label=<variant>,pos="0,-219.6!",height=.36]; EvaluationRun -- EvaluationRun_1;
EvaluationRun_2 [label=<critic_enabled>,pos="0,-270.0!",height=.36]; EvaluationRun -- EvaluationRun_2;
EvaluationRun_3 [label=<multimodal_enabled>,pos="0,-320.4!",height=.36]; EvaluationRun -- EvaluationRun_3;
EvaluationRun_4 [label=<configuration>,pos="403.2,-194.4!",height=.36]; EvaluationRun -- EvaluationRun_4;
EvaluationRun_5 [label=<run_status>,pos="403.2,-244.79999999999998!",height=.36]; EvaluationRun -- EvaluationRun_5;
EvaluationRun_6 [label=<started_at>,pos="403.2,-295.2!",height=.36]; EvaluationRun -- EvaluationRun_6;
EvaluationOutput [shape=box,fillcolor="#DDF0E7",color="#368D7D",fontsize=14,label="EvaluationOutput",pos="201.6,-489.59999999999997!",width=1.55,height=.45];
EvaluationOutput_0 [label=<<U>output_id</U>>,pos="0,-439.2!",height=.36]; EvaluationOutput -- EvaluationOutput_0;
EvaluationOutput_1 [label=<run_id <FONT POINT-SIZE="9">(FK)</FONT>>,pos="0,-489.59999999999997!",height=.36]; EvaluationOutput -- EvaluationOutput_1;
EvaluationOutput_2 [label=<case_id <FONT POINT-SIZE="9">(FK)</FONT>>,pos="0,-540.0!",height=.36]; EvaluationOutput -- EvaluationOutput_2;
EvaluationOutput_3 [label=<output_text>,pos="403.2,-439.2!",height=.36]; EvaluationOutput -- EvaluationOutput_3;
EvaluationOutput_4 [label=<output_status>,pos="403.2,-489.59999999999997!",height=.36]; EvaluationOutput -- EvaluationOutput_4;
EvaluationOutput_5 [label=<elapsed_ms>,pos="403.2,-540.0!",height=.36]; EvaluationOutput -- EvaluationOutput_5;
}