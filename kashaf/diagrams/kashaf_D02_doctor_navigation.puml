@startuml
' Owner: Kashaf. Physician/System swimlane retained alongside thumbnails.
skinparam backgroundColor white
skinparam shadowing false
skinparam activityBackgroundColor #E2F1EA
skinparam activityBorderColor #258B76
skinparam ArrowColor #258B76
|#EDF6F1|Physician|
start
:Sign Up or Log In
UC01-UC02;
|#EDF2FB|Zeest|
:Validate account and establish session;
:Display the physician's own patients;
|Physician|
:Select patient and existing encounter
UC03-UC06;
:Record consultation and correct notes
UC07-UC08;
:Supply clinical inputs
UC09-UC11;
|Zeest|
:Retain input revisions and analyse;
:Display specialist findings
UC12;
|Physician|
:Request clinical draft
UC13;
|Zeest|
:Retrieve patient history and guidelines;
:Generate diagnosis and treatment draft;
:Perform critic review;
|Physician|
:Inspect draft, evidence and critic findings
UC13-UC15;
while (Modify draft?) is (yes)
 :Edit and save modification
UC16;
 |Zeest|
 :Retain revised draft as pending;
 |Physician|
 :Review revised content;
endwhile (no)
if (Approve?) then (yes)
 :Confirm approval
UC17;
 |Zeest|
 :Validate reviewed revision and record decision;
 :Record approval action;
 |Physician|
 :View approved decision
UC19;
else (reject)
 :Confirm rejection
UC18;
 |Zeest|
 :Retain rejected state and record action;
endif
|Physician|
:Inspect audit history
UC20;
:Log Out
UC21;
|Zeest|
:End session;
stop
@enduml
