!theme plain
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam rectangleBorderColor #29796E
skinparam rectangleBackgroundColor #E5F2EC
skinparam ArrowColor #29796E
rectangle "Select permitted cases\nand reference assessments" as A
rectangle "Select variants\nand comparison settings" as B
