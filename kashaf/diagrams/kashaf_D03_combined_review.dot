PhysicianAction_a3 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<physician_id <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
PhysicianAction -> PhysicianAction_a3 [color="#B7C7BB",penwidth=.7];
PhysicianAction_a4 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<action_kind>,fontsize=10];
