PhysicianAction_a6 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<action_at>,fontsize=10];
PhysicianAction -> PhysicianAction_a6 [color="#B7C7BB",penwidth=.7];
{rank=same; PhysicianAction_a0;PhysicianAction_a1;PhysicianAction_a2;PhysicianAction_a3;PhysicianAction_a4;PhysicianAction_a5;PhysicianAction_a6;}
ClinicalDecision [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="ClinicalDecision"];
ClinicalDecision_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>decision_id</U>>,fontsize=10];
