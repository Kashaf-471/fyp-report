SemanticMemory [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="SemanticMemory"];
SemanticMemory_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>memory_id</U>>,fontsize=10];
