Physician [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="Physician"];
Physician_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>physician_id</U>>,fontsize=10];
