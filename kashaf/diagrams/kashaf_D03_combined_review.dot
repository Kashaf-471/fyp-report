r12 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="performs",fontsize=10];
Physician -> r12 [taillabel="1",labeldistance=1.6]; r12 -> PhysicianAction [headlabel="0..N",labeldistance=1.6];
r13 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="reviewed in",fontsize=10];
ProposalRevision -> r13 [taillabel="1",labeldistance=1.6]; r13 -> PhysicianAction [headlabel="0..N",labeldistance=1.6];
r14 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="authorises",fontsize=10];
PhysicianAction -> r14 [taillabel="1",labeldistance=1.6]; r14 -> ClinicalDecision [headlabel="0..1",labeldistance=1.6];
r15 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="accepted as",fontsize=10];
ProposalRevision -> r15 [taillabel="1",labeldistance=1.6]; r15 -> ClinicalDecision [headlabel="0..1",labeldistance=1.6];
r16 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="represented by",fontsize=10];
InputRevision -> r16 [taillabel="0..1",labeldistance=1.6]; r16 -> SemanticMemory [headlabel="0..N",labeldistance=1.6];
r17 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="represented by",fontsize=10];
ClinicalDecision -> r17 [taillabel="0..1",labeldistance=1.6]; r17 -> SemanticMemory [headlabel="0..N",labeldistance=1.6];
}