SemanticMemory_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<input_id <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
SemanticMemory -> SemanticMemory_a1 [color="#B7C7BB",penwidth=.7];
SemanticMemory_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<input_revision <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
