EvidenceItem_a3 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<retrieved_at>,fontsize=10];
EvidenceItem -> EvidenceItem_a3 [color="#B7C7BB",penwidth=.7];
{rank=same; EvidenceItem_a0;EvidenceItem_a1;EvidenceItem_a2;EvidenceItem_a3;}
ProposalEvidence [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="ProposalEvidence"];
ProposalEvidence_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>proposal_id</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
