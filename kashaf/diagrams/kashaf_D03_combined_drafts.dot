EvidenceItem_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<source_ref>,fontsize=10];
EvidenceItem -> EvidenceItem_a1 [color="#B7C7BB",penwidth=.7];
EvidenceItem_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<passage_text>,fontsize=10];
