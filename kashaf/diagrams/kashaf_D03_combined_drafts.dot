CriticReview -> CriticReview_a4 [color="#B7C7BB",penwidth=.7];
CriticReview_a5 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<reviewed_at>,fontsize=10];
CriticReview -> CriticReview_a5 [color="#B7C7BB",penwidth=.7];
{rank=same; CriticReview_a0;CriticReview_a1;CriticReview_a2;CriticReview_a3;CriticReview_a4;CriticReview_a5;}
EvidenceItem [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="EvidenceItem"];
EvidenceItem_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>evidence_id</U>>,fontsize=10];
