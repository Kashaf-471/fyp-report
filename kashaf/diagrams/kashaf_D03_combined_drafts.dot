digraph Chen {
graph [rankdir=LR,compound=true,bgcolor="white",pad="0.25",nodesep="0.15",ranksep="0.30",dpi=240];
node [fontname="Arial",fontsize=12,penwidth=1.1];
edge [fontname="Arial",fontsize=10,color="#779289",dir=none];
Proposal [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="Proposal"];
Proposal_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>proposal_id</U>>,fontsize=10];
Proposal -> Proposal_a0 [color="#B7C7BB",penwidth=.7];
Proposal_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<encounter_id <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
Proposal -> Proposal_a1 [color="#B7C7BB",penwidth=.7];
Proposal_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<created_at>,fontsize=10];
Proposal -> Proposal_a2 [color="#B7C7BB",penwidth=.7];
{rank=same; Proposal_a0;Proposal_a1;Proposal_a2;}
ProposalRevision [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="ProposalRevision"];
ProposalRevision_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>proposal_id</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalRevision -> ProposalRevision_a0 [color="#B7C7BB",penwidth=.7];
ProposalRevision_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>revision_no</U>>,fontsize=10];
ProposalRevision -> ProposalRevision_a1 [color="#B7C7BB",penwidth=.7];
ProposalRevision_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<diagnosis_text>,fontsize=10];
ProposalRevision -> ProposalRevision_a2 [color="#B7C7BB",penwidth=.7];
ProposalRevision_a3 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<treatment_text>,fontsize=10];
ProposalRevision -> ProposalRevision_a3 [color="#B7C7BB",penwidth=.7];
ProposalRevision_a4 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<review_status>,fontsize=10];
ProposalRevision -> ProposalRevision_a4 [color="#B7C7BB",penwidth=.7];
ProposalRevision_a5 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<created_at>,fontsize=10];
ProposalRevision -> ProposalRevision_a5 [color="#B7C7BB",penwidth=.7];
{rank=same; ProposalRevision_a0;ProposalRevision_a1;ProposalRevision_a2;ProposalRevision_a3;ProposalRevision_a4;ProposalRevision_a5;}
ProposalInput [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="ProposalInput"];
ProposalInput_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>proposal_id</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalInput -> ProposalInput_a0 [color="#B7C7BB",penwidth=.7];
ProposalInput_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>proposal_revision</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalInput -> ProposalInput_a1 [color="#B7C7BB",penwidth=.7];
ProposalInput_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>input_id</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalInput -> ProposalInput_a2 [color="#B7C7BB",penwidth=.7];
ProposalInput_a3 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>input_revision</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalInput -> ProposalInput_a3 [color="#B7C7BB",penwidth=.7];
{rank=same; ProposalInput_a0;ProposalInput_a1;ProposalInput_a2;ProposalInput_a3;}
CriticReview [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="CriticReview"];
CriticReview_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>critic_id</U>>,fontsize=10];
CriticReview -> CriticReview_a0 [color="#B7C7BB",penwidth=.7];
CriticReview_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<proposal_id <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
