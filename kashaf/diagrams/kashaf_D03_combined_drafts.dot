ProposalEvidence_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>proposal_revision</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalEvidence -> ProposalEvidence_a1 [color="#B7C7BB",penwidth=.7];
ProposalEvidence_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>evidence_id</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
ProposalEvidence -> ProposalEvidence_a2 [color="#B7C7BB",penwidth=.7];
{rank=same; ProposalEvidence_a0;ProposalEvidence_a1;ProposalEvidence_a2;}
InputRevision [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="InputRevision"];
InputRevision_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>input_id</U> <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
InputRevision -> InputRevision_a0 [color="#B7C7BB",penwidth=.7];
InputRevision_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>revision_no</U>>,fontsize=10];
InputRevision -> InputRevision_a1 [color="#B7C7BB",penwidth=.7];
InputRevision_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<content_text>,fontsize=10];
InputRevision -> InputRevision_a2 [color="#B7C7BB",penwidth=.7];
InputRevision_a3 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<file_ref>,fontsize=10];
InputRevision -> InputRevision_a3 [color="#B7C7BB",penwidth=.7];
InputRevision_a4 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<recorded_at>,fontsize=10];
InputRevision -> InputRevision_a4 [color="#B7C7BB",penwidth=.7];
{rank=same; InputRevision_a0;InputRevision_a1;InputRevision_a2;InputRevision_a3;InputRevision_a4;}
Encounter [shape=box,style=filled,fillcolor="#72A8DC",fontcolor="white",color="#4E83B7",label="Encounter"];
Encounter_a0 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<<U>encounter_id</U>>,fontsize=10];
Encounter -> Encounter_a0 [color="#B7C7BB",penwidth=.7];
Encounter_a1 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<patient_id <FONT POINT-SIZE="9">FK</FONT>>,fontsize=10];
Encounter -> Encounter_a1 [color="#B7C7BB",penwidth=.7];
Encounter_a2 [shape=ellipse,style=filled,fillcolor="#D9EEDD",color="#8DBD98",label=<recorded_at>,fontsize=10];
Encounter -> Encounter_a2 [color="#B7C7BB",penwidth=.7];
{rank=same; Encounter_a0;Encounter_a1;Encounter_a2;}
r5 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="produces",fontsize=10];
Encounter -> r5 [taillabel="1",labeldistance=1.6]; r5 -> Proposal [headlabel="0..N",labeldistance=1.6];
r6 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="versions",fontsize=10];
Proposal -> r6 [taillabel="1",labeldistance=1.6]; r6 -> ProposalRevision [headlabel="1..N",labeldistance=1.6];
r7 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="uses",fontsize=10];
ProposalRevision -> r7 [taillabel="1",labeldistance=1.6]; r7 -> ProposalInput [headlabel="0..N",labeldistance=1.6];
r8 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="supplies",fontsize=10];
InputRevision -> r8 [taillabel="1",labeldistance=1.6]; r8 -> ProposalInput [headlabel="0..N",labeldistance=1.6];
r9 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="assessed by",fontsize=10];
ProposalRevision -> r9 [taillabel="1",labeldistance=1.6]; r9 -> CriticReview [headlabel="0..N",labeldistance=1.6];
r10 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="supports",fontsize=10];
ProposalRevision -> r10 [taillabel="1",labeldistance=1.6]; r10 -> ProposalEvidence [headlabel="0..N",labeldistance=1.6];
r11 [shape=diamond,style=filled,fillcolor="#F1D8AC",color="#C59D60",label="linked by",fontsize=10];
EvidenceItem -> r11 [taillabel="1",labeldistance=1.6]; r11 -> ProposalEvidence [headlabel="0..N",labeldistance=1.6];
}