@startuml esha_D11_approval_states
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 160
skinparam nodesep 32
skinparam ranksep 32

skinparam state {
    BackgroundColor #EDF2F7
    BorderColor #2B6CB0
    BorderThickness 1.2
    FontColor #1A202C
    FontStyle bold
    StartColor #2B6CB0
    EndColor #C53030
}

skinparam note {
    BackgroundColor #FEFCBF
    BorderColor #B7791F
    FontColor #744210
    FontSize 10
}

skinparam arrow {
    Color #4A5568
    Thickness 1.2
    FontColor #2D3748
    FontSize 10
}

title Proposed Physician Approval States (D11)

[*] --> CaseDrafting : Encounter opened & inputs submitted

state "Case Inputs Confirmed" as CaseDrafting

CaseDrafting --> SynthesisAndCritic : Physician requests recommendation (FR26)

state "Synthesis and Critic Review" as SynthesisAndCritic

SynthesisAndCritic --> PendingReview : Proposal persisted with revision k

state "Pending Physician Review\nnot a clinical decision" as PendingReview

state "Modified Draft Pending\nnew revision + audit entry" as ModifiedDraftPending

state "Approved Clinical Decision\napproval audit entry recorded" as ExplicitlyApproved

state "Indexed in Patient Memory\navailable to later encounters" as IndexedInSemanticMemory

state "Rejected Proposal\naudit retained; no clinical decision" as ExplicitlyRejected

' Transitions
PendingReview --> ModifiedDraftPending : Modify (FR34)
ModifiedDraftPending --> ModifiedDraftPending : Modify again

PendingReview --> ExplicitlyApproved : Approve (FR33)
ModifiedDraftPending --> ExplicitlyApproved : Approve revision (FR33)

PendingReview --> ExplicitlyRejected : Reject (FR35)
ModifiedDraftPending --> ExplicitlyRejected : Reject revision (FR35)

ExplicitlyApproved --> IndexedInSemanticMemory : Index approved decision

ExplicitlyRejected --> [*]
IndexedInSemanticMemory --> [*]

note right of ModifiedDraftPending
  Every modify, approve and reject action is retained
  with physician, time, revision and reviewed snapshot.
end note

note right of ExplicitlyRejected
  Rejected proposals never enter the clinical record
  or semantic patient memory.
end note

@enduml
